{% extends '@NowoPdfEditorBundle/editor/layout.html.twig' %}

{% block nowo_pdf_editor_title %}{{ 'pdf_editor.home.title'|trans({}, 'NowoPdfEditorBundle') }}{% endblock %}

{% block nowo_pdf_editor_body %}
    <div class="demo-upload-shell">
        <section class="demo-upload-card">
            <h1>{{ 'pdf_editor.home.heading'|trans({}, 'NowoPdfEditorBundle') }}</h1>
            <p class="demo-lead">{{ 'pdf_editor.home.lead'|trans({}, 'NowoPdfEditorBundle') }}</p>
            <div class="demo-upload-drop">
                <p>{{ 'demo.upload.drop_hint'|trans|default('Drop a PDF here or choose a file below') }}</p>
                {{ form_start(form, { attr: { class: 'nowo-ui-form', enctype: 'multipart/form-data' } }) }}
                    {{ form_row(form.pdf) }}
                    <button type="submit" class="nowo-ui-btn nowo-ui-btn-primary">{{ 'pdf_editor.home.open'|trans({}, 'NowoPdfEditorBundle') }}</button>
                {{ form_end(form) }}
            </div>
        </section>
        <aside class="demo-upload-aside">
            <h2 class="nowo-ui-subtitle">{{ 'demo.upload.how_it_works'|trans|default('How it works') }}</h2>
            <ol>
                <li>{{ 'demo.upload.step1'|trans|default('Open the workspace with your PDF.') }}</li>
                <li>{{ 'demo.upload.step2'|trans|default('Queue text, form, watermark or page edits.') }}</li>
                <li>{{ 'demo.upload.step3'|trans|default('Save to PDF — Symfony calls Python/PyMuPDF.') }}</li>
                <li>{{ 'demo.upload.step4'|trans|default('Download the result.') }}</li>
            </ol>
        </aside>
    </div>
{% endblock %}
