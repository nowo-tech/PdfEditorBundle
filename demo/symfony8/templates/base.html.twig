{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. It is
    also the host layout of the editor pages (nowo_ui_kit.layouts.admin: the upload form scaffold and the PDF
    workspace unique page). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'PDF Editor',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/PdfEditorBundle',
    translation_domain: 'messages',
    locales: [
        {code: 'en', href: path('demo_locale_switch', {locale: 'en'})},
        {code: 'es', href: path('demo_locale_switch', {locale: 'es'})},
    ],
    nav: [
        {label: 'demo.nav.about', route: 'demo_home'},
        {label: 'demo.nav.scenarios', route: 'demo_scenarios', active: ['demo_scenarios', 'demo_scenario_*']},
        {label: 'demo.nav.editor', route: 'nowo_pdf_editor_home', active: ['nowo_pdf_editor*']},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}PdfEditorBundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
