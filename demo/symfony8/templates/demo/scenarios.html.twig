{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.scenarios.title'|trans }} — PdfEditorBundle{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.scenarios.title'|trans,
        intro: 'demo.scenarios.lead'|trans,
    }) }}
{% endblock %}

{% block body %}
    <div class="nowo-ui-row-actions">
        <a href="{{ path('nowo_pdf_editor_home') }}" class="nowo-ui-btn nowo-ui-btn--outline">{{ 'demo.scenarios.upload'|trans }}</a>
        <a href="{{ path('demo_home') }}" class="nowo-ui-btn nowo-ui-btn--outline">{{ 'demo.nav.about'|trans }}</a>
    </div>

    <div class="nowo-ui-cards">
        {% for scenario in scenarios %}
            <article class="nowo-ui-card" data-testid="demo-scenario-card">
                <div class="nowo-ui-card__header"><h2>{{ ('demo.scenario.' ~ scenario.id ~ '.title')|trans }}</h2></div>
                <div class="nowo-ui-card__body">
                    <p class="nowo-ui-muted">{{ ('demo.scenario.' ~ scenario.id ~ '.lead')|trans }}</p>
                    <p>
                        {% for tool in scenario.tools %}
                            <code class="nowo-ui-code">{{ tool }}</code>
                        {% endfor %}
                    </p>
                    <ol>
                        {% for item in scenario.checklist %}
                            <li>{{ item }}</li>
                        {% endfor %}
                    </ol>
                    <a href="{{ path('demo_scenario_open', { scenario: scenario.id }) }}" class="nowo-ui-btn nowo-ui-btn--primary">
                        {{ 'demo.scenarios.open'|trans }}
                    </a>
                </div>
            </article>
        {% endfor %}
    </div>
{% endblock %}
