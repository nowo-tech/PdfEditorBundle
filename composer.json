{
    "name": "nowo-tech/pdf-editor-bundle",
    "description": "Symfony bundle with an isolated, access-controlled PDF editor workspace: edit text, form fields, watermarks, pages and annotations in the browser, then download the result.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "pdf",
        "pdf-editor",
        "acroform",
        "watermark",
        "pymupdf",
        "frankenphp",
        "worker"
    ],
    "homepage": "https://packagist.org/packages/nowo-tech/pdf-editor-bundle",
    "support": {
        "issues": "https://github.com/nowo-tech/PdfEditorBundle/issues",
        "source": "https://github.com/nowo-tech/PdfEditorBundle",
        "docs": "https://github.com/nowo-tech/PdfEditorBundle/tree/main/docs"
    },
    "authors": [
        {
            "name": "H\u00e9ctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "nowo-tech/ui-kit-bundle": "^2.17.3",
        "psr/clock": "^1.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "symfony/asset": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/deprecation-contracts": "^3.0",
        "symfony/form": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/options-resolver": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12",
        "twig/twig": "^3.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "igor-php/igor-php": "^0.9.7",
        "nowo-tech/phpstan-frankenphp": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "rector/rector": "^2.0",
        "symfony/console": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\PdfEditorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\PdfEditorBundle\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --colors=always",
        "test-unit": "phpunit --testsuite=Unit",
        "test-integration": "phpunit --testsuite=Integration",
        "test-coverage": "phpunit --colors=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text | tee coverage-php.txt && sh .scripts/php-coverage-percent.sh coverage-php.txt",
        "coverage-check": "phpunit --colors=always --coverage-text=coverage-output.txt --coverage-clover coverage.xml && sh .scripts/coverage-fail-under.sh coverage-output.txt 100",
        "test-coverage-100": "@coverage-check",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "qa": [
            "@cs-check",
            "@test"
        ],
        "igor": "igor-php --no-agent ."
    },
    "suggest": {
        "symfony/flex": "For automatic recipe installation",
        "symfony/security-bundle": "Role-based editor access when allow_unauthenticated is false"
    },
    "scripts-descriptions": {
        "igor": "Run Igor FrankenPHP worker-state audit (REQ-CS-008)"
    }
}
